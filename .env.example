# ---------------------------------------------------------------------------
# Wedding Registry — environment variables
# Copy this file to `.env` and fill in the values.
#
# Only DATABASE_URL and SESSION_SECRET are required. Everything else is an
# optional, plug-and-play integration — leave it unset to use the safe default
# (no emails, simulated payments, URL-only images).
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Postgres connection string.
# Local dev:   postgresql://user:password@localhost:5432/wedding_registry
# Neon/Vercel: copy the "pooled" connection string from your dashboard.
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_registry?schema=public"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Payments (optional) ----------------------------------------------------
# "simulated" (default) records cash pledges without charging anyone.
# Set "stripe" and the keys below to use real Stripe PaymentIntents.
#   Requires:  npm install stripe
PAYMENT_PROVIDER="simulated"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."     # from `stripe listen` or the dashboard
# STRIPE_CURRENCY="usd"                 # optional, defaults to usd

# --- Email notifications (optional) -----------------------------------------
# "none" (default) logs instead of sending. Set "resend" to email the couple
# when a gift is claimed or an RSVP arrives.
#   Requires:  npm install resend
EMAIL_PROVIDER="none"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Wedding Registry <onboarding@resend.dev>"
# (The couple's recipient address is set in the admin, not here.)

# --- Image uploads (optional) -----------------------------------------------
# "none" (default) means admins paste a photo URL. Set "vercel-blob" to enable
# file uploads in the admin.
#   Requires:  npm install @vercel/blob   (and a Vercel Blob store)
STORAGE_PROVIDER="none"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
